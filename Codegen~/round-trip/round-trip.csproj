<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Protocol DTOs from the Runtime package — compiled here for the round-trip test. -->
    <!-- In Unity, these compile as part of the Assembly Definition; here they compile standalone. -->
    <Compile Include="../../Runtime/Core/Protocol/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Matches the Newtonsoft.Json version shipped by com.unity.nuget.newtonsoft-json@3.x. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
