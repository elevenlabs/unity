{
  "name": "elevenlabs-codegen-dev",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/*.test.ts",
    "generate": "node src/generate-protocol-dtos.ts && dotnet csharpier format --include-generated ../Runtime/Core/Protocol/",
    "round-trip": "dotnet run --project round-trip/",
    "verify:protocol-dtos": "pnpm run generate && git diff --exit-code -- ../Runtime/Core/Protocol/ round-trip/Program.cs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^25.9.2",
    "eslint": "^9.0.0",
    "globals": "^17.6.0",
    "prettier": "^3.0.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@asyncapi/modelina": "^5.10.1",
    "@asyncapi/parser": "^3.6.0"
  },
  "pnpm": {
    "overrides": {
      "ajv@<6.14.0": "^6.14.0",
      "js-yaml@<4.2.0": "^4.2.0",
      "jsonpath-plus@<10.3.0": "^10.3.0"
    }
  }
}
