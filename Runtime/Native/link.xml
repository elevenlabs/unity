<!--
  Preserves stripping-fragile entry points for the native (non-WebGL)
  transport path.

  ElevenLabs.Native.NativeSessionLauncher: registers
  Conversation.SessionFactory via a [RuntimeInitializeOnLoadMethod] hook on
  Editor / standalone / mobile. Consumer projects only reference
  Conversation.StartSessionAsync, not the platform asmdef, so IL2CPP
  strips the launcher type entirely (along with the attribute) and
  StartSessionAsync throws "No session factory is registered". Mirrors
  the BridgedSessionLauncher preserve in Runtime/WebGL/link.xml.

  ElevenLabs.Protocol.* wire DTOs: every IncomingSocketEvent /
  OutgoingSocketEvent subclass and its nested event payload classes are
  deserialised from JSON via IncomingSocketEventConverter and serialised
  via JsonConvert.SerializeObject. Newtonsoft.Json relies on reflection
  over the parameterless constructor + [JsonProperty]-attributed
  property setters/getters, which IL2CPP's managed stripping prunes
  because no statically reachable C# code calls them directly.

  Wildcards (e.g. <type fullname="ElevenLabs.Protocol.*"/>) are NOT
  honoured by Unity's UnityLinker — confirmed by the
  com.unity.nuget.newtonsoft-json package's link.xml (which lists each
  type explicitly) and by the runtime symptom of a stripped
  ConversationInitiationMetadata default constructor on the first
  standalone smoke run. Every type is therefore listed explicitly
  below; the Codegen pipeline emits a deterministic set so drift here
  is caught by the smoke test.

  This file is fed to UnityLinker explicitly via the
  `LinkXmlInjector` IUnityLinkerProcessor in Editor/. Unity's
  auto-discovery of package-internal link.xml files is unreliable when
  the package is referenced as a local file-path package whose root
  is the repo root (manifest.json: "file:../..") — the file shows up
  in the import log but never reaches UnityLinker's include-link-xml
  argument list, so it's silently ignored. The explicit callback
  sidesteps the discovery path entirely.
-->
<linker>
  <assembly fullname="ElevenLabs.Agents.Native">
    <type fullname="ElevenLabs.Native.NativeSessionLauncher" preserve="all" />
  </assembly>
  <assembly fullname="ElevenLabs.Agents.Core">
    <!-- IncomingSocketEvent hierarchy -->
    <type fullname="ElevenLabs.Protocol.IncomingSocketEvent" preserve="all" />
    <type fullname="ElevenLabs.Protocol.IncomingSocketEventConverter" preserve="all" />
    <type fullname="ElevenLabs.Protocol.IncomingEventDispatcher" preserve="all" />
    <type fullname="ElevenLabs.Protocol.UnknownIncomingEvent" preserve="all" />
    <type fullname="ElevenLabs.Protocol.ConversationInitiationMetadata" preserve="all" />
    <type fullname="ElevenLabs.Protocol.ConversationInitiationMetadataEvent" preserve="all" />
    <type fullname="ElevenLabs.Protocol.AgentResponse" preserve="all" />
    <type fullname="ElevenLabs.Protocol.AgentResponseEvent" preserve="all" />
    <type fullname="ElevenLabs.Protocol.AgentResponseComplete" preserve="all" />
    <type fullname="ElevenLabs.Protocol.AgentResponseCompleteEvent" preserve="all" />
    <type fullname="ElevenLabs.Protocol.AgentResponseCorrection" preserve="all" />
    <type fullname="ElevenLabs.Protocol.AgentResponseCorrectionEvent" preserve="all" />
    <type fullname="ElevenLabs.Protocol.UserTranscript" preserve="all" />
